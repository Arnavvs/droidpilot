# --- Model: OpenRouter (remote, cheap) -------------------------------------
OPENROUTER_API_KEY=sk-or-v1-...
DROIDPILOT_PROVIDER=openrouter
DROIDPILOT_MODEL=deepseek/deepseek-v4-flash-0731

# --- Model: local llama.cpp on the phone -----------------------------------
# DROIDPILOT_PROVIDER=local
# DROIDPILOT_LOCAL_URL=http://127.0.0.1:8080/v1
# DROIDPILOT_LOCAL_MODEL=local
# DROIDPILOT_TOOL_MODE=json      # small models have no native tool calling

# --- Server ----------------------------------------------------------------
# DROIDPILOT_TOKEN=            # auto-generated into ~/.droidpilot/token
# DROIDPILOT_SERIAL=           # adb serial, if more than one device

# --- Laptop bridge ---------------------------------------------------------
# DROIDPILOT_URL=http://192.168.1.5:8765
